rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'v-cleand@microsoft.com';
    }
    match /access_requests/{requestId} {
      allow create: if request.resource.data.status == 'pendente'
        && request.resource.data.nome is string
        && request.resource.data.email is string
        && request.resource.data.empresa is string
        && request.resource.data.cargo is string;
      allow read, update: if isAdmin();
      allow delete: if false;
    }
    match /price_list/{catalogId} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin()
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 10000;
      allow delete: if false;
    }
  }
}
